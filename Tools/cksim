#!/usr/bin/env python3
"""Control CallKit Simulator in one running simulator app. No third-party dependencies."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import time
import tempfile
import uuid


SIMCTL_TIMEOUT = 60
INCOMING_FILTER_REASONS = ("none", "do-not-disturb", "restricted-sharing-mode",
                           "call-is-protected", "sensitive-participants")
INSTALL_KEYS = ("DYLD_INSERT_LIBRARIES", "CKSIM_RUNTIME", "CKSIM_BUNDLE_IDS", "CKSIM_ENABLED", "CKSIM_PROFILE")


def simctl(*args, env=None, timeout=None):
    timeout = SIMCTL_TIMEOUT if timeout is None else timeout
    if len(args) >= 3 and args[0] == "spawn" and args[2] == "launchctl":
        # Recovery must run even when launchd names a loader deleted from disk.
        # This changes only the control process, never the saved global value.
        env = {**(os.environ if env is None else env), "SIMCTL_CHILD_DYLD_INSERT_LIBRARIES": ""}
    try:
        result = subprocess.run(["xcrun", "simctl", *map(str, args)], capture_output=True, text=True,
                                env=env, timeout=timeout)
    except subprocess.TimeoutExpired as error:
        raise RuntimeError(f"simctl {args[0]} timed out after {timeout}s; inspect state before retrying.") from error
    if result.returncode:
        raise RuntimeError(f"simctl {args[0]} failed: {result.stderr.strip()}")
    return result.stdout.strip()


def simulator(identifier):
    if identifier != "booted":
        return str(uuid.UUID(identifier)).upper()
    data = json.loads(simctl("list", "devices", "booted", "-j"))
    matches = [d["udid"] for devices in data["devices"].values() for d in devices if d["state"] == "Booted"]
    if len(matches) != 1:
        raise RuntimeError("Select --simulator UUID explicitly when zero or multiple simulators are booted.")
    return matches[0]


def target_container(args, device):
    cached = getattr(args, "app_container", None)
    if cached is None:
        return Path(simctl("get_app_container", device, args.bundle, "data"))
    try:
        container = Path(cached).resolve(strict=True)
        expected = (str(uuid.UUID(device)), "data", "Containers", "Data", "Application")
        if (not container.is_dir() or
                tuple(part.casefold() for part in container.parts[-6:-1]) != tuple(part.casefold() for part in expected)):
            raise ValueError("wrong simulator data-container path")
        uuid.UUID(container.name)
    except (OSError, ValueError) as error:
        raise RuntimeError("Cached app container must be an existing data container for the selected simulator.") from error
    # The caller still validates the bundle and runtime session in this path.
    return container


def launch_environment(device, key):
    try:
        result = subprocess.run(["xcrun", "simctl", "spawn", device, "launchctl", "getenv", key], capture_output=True, text=True,
                                env={**os.environ, "SIMCTL_CHILD_DYLD_INSERT_LIBRARIES": ""}, timeout=SIMCTL_TIMEOUT)
    except subprocess.TimeoutExpired as error:
        raise RuntimeError(f"Reading simulator environment key {key} timed out after {SIMCTL_TIMEOUT}s.") from error
    diagnostic = result.stderr.strip()
    if result.returncode or diagnostic:
        raise RuntimeError(f"Cannot read simulator environment key {key}: {diagnostic}")
    # launchctl emits no bytes for an unset key and one newline for an empty
    # value. Preserve empty values and any newlines already in the value.
    return None if not result.stdout else result.stdout.removesuffix("\n")


def validate_package(runtime):
    info = json.loads((runtime / "build-info.json").read_text())
    required = {"CKSimRuntime.dylib", "CKSimLoader.dylib", "cksim-notify", "cksim", "profiles/ios-27.0.json"}
    version = (runtime / "VERSION").read_text().strip()
    if (info.get("schemaVersion") != 1 or not re.fullmatch(r"(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)", version) or
            info.get("version") != version or "VERSION" not in info.get("files", {}) or not required.issubset(info.get("files", {}))):
        raise RuntimeError("Incomplete or unsupported runtime package.")
    for name, digest in info["files"].items():
        path = runtime / name
        if not path.resolve().is_relative_to(runtime.resolve()) or hashlib.sha256(path.read_bytes()).hexdigest() != digest:
            raise RuntimeError(f"Runtime package checksum mismatch: {name}")


def save_state(path, value):
    descriptor, temporary = tempfile.mkstemp(prefix=".install-", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w") as output:
            os.fchmod(output.fileno(), 0o600)
            json.dump(value, output)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def managed_values(saved, key):
    return saved.get("recoverable", {}).get(key, [saved["applied"][key], saved["original"][key]])


def install(args, device):
    runtime = args.runtime_dir.resolve()
    validate_package(runtime)
    root = Path.home() / ".local/state/callkit-simulator"
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    statefile = root / f"{device}.json"
    if statefile.exists():
        saved = json.loads(statefile.read_text())
        if saved["runtime"] != str(runtime):
            raise RuntimeError("Uninstall the existing runtime before selecting another release.")
        bundles = sorted(set(saved["bundles"] + [args.bundle]))
        original = saved["original"]
    else:
        bundles = [args.bundle]
        original = {key: launch_environment(device, key) for key in INSTALL_KEYS}
    if statefile.exists():
        for key, value in saved["applied"].items():
            if launch_environment(device, key) not in managed_values(saved, key):
                raise RuntimeError(f"{key} changed outside this installation; refusing to overwrite it.")
    values = {"DYLD_INSERT_LIBRARIES": ":".join(filter(None, [original["DYLD_INSERT_LIBRARIES"], str(runtime / "CKSimLoader.dylib")])),
              "CKSIM_RUNTIME": str(runtime / "CKSimRuntime.dylib"), "CKSIM_BUNDLE_IDS": ",".join(bundles),
              "CKSIM_ENABLED": "1", "CKSIM_PROFILE": "ios-27.0"}
    recoverable = {key: list(dict.fromkeys([original[key], value, *(managed_values(saved, key) if statefile.exists() else [])]))
                   for key, value in values.items()}
    saved = dict(runtime=str(runtime), bundles=bundles, original=original, applied=values, recoverable=recoverable)
    save_state(statefile, saved)
    for key, value in values.items():
        simctl("spawn", device, "launchctl", "setenv", key, value)
    saved.pop("recoverable")
    save_state(statefile, saved)
    return dict(installed=True, simulator=device, bundles=bundles, profile="ios-27.0")


def uninstall(device):
    statefile = Path.home() / f".local/state/callkit-simulator/{device}.json"
    saved = json.loads(statefile.read_text())
    for key, value in saved["applied"].items():
        if launch_environment(device, key) not in managed_values(saved, key):
            raise RuntimeError(f"{key} changed after installation; use repair to preserve unrelated loader entries.")
    for key, value in saved["original"].items():
        if value is None:
            simctl("spawn", device, "launchctl", "unsetenv", key)
        else:
            simctl("spawn", device, "launchctl", "setenv", key, value)
    statefile.unlink()
    return dict(uninstalled=True, simulator=device)


def repair(device):
    statefile = Path.home() / f".local/state/callkit-simulator/{device}.json"
    if not statefile.exists():
        return dict(repaired=False, simulator=device, reason="No saved installation.")
    saved = json.loads(statefile.read_text())
    if not isinstance(saved, dict):
        raise RuntimeError(f"Invalid ownership state in {statefile}; inspect this file before repair.")
    for field in ("original", "applied"):
        values = saved.get(field)
        if (not isinstance(values, dict) or set(values) != set(INSTALL_KEYS) or
                any(value is not None and not isinstance(value, str) for value in values.values())):
            raise RuntimeError(f"Invalid {field} ownership values in {statefile}; inspect this file before repair.")
    if not isinstance(saved.get("runtime"), str) or not Path(saved["runtime"]).is_absolute():
        raise RuntimeError(f"Invalid runtime ownership path in {statefile}; inspect this file before repair.")
    recoverable = saved.get("recoverable", {})
    if (not isinstance(recoverable, dict) or any(key not in INSTALL_KEYS or not isinstance(values, list) or
            any(value is not None and not isinstance(value, str) for value in values)
            for key, values in recoverable.items())):
        raise RuntimeError(f"Invalid recoverable ownership values in {statefile}; inspect this file before repair.")

    def ambiguous(key):
        raise RuntimeError(f"{key} changed outside this installation; repair left the environment unchanged. "
                           f"Inspect simulator key {key} and {statefile}; preserve external edits, restore a saved "
                           "original/applied value deliberately, then retry repair.")

    current = {key: launch_environment(device, key) for key in INSTALL_KEYS}
    target = dict(saved["original"])
    # Preflight every key before the first write. Only the recorded exact loader
    # entry belongs to us; other injectors may append or remove their own entries.
    for key in INSTALL_KEYS[1:]:
        if current[key] not in managed_values(saved, key):
            ambiguous(key)
    key = "DYLD_INSERT_LIBRARIES"
    loader = str(Path(saved["runtime"]) / "CKSimLoader.dylib")
    original = saved["original"][key]
    expected = ":".join(filter(None, [original, loader]))
    if saved["applied"][key] != expected:
        raise RuntimeError(f"Invalid loader ownership in {statefile}; inspect this file before repair.")
    entries = current[key].split(":") if current[key] is not None else []
    original_count = original.split(":").count(loader) if original is not None else 0
    if entries.count(loader) > original_count + 1:
        ambiguous(key)
    if entries.count(loader) > original_count:
        entries.reverse()
        entries.remove(loader)
        entries.reverse()
        target[key] = ":".join(entries)
        if current[key] == loader:
            target[key] = "" if original == "" else None
    else:
        target[key] = current[key]
    for key, value in target.items():
        if current[key] == value:
            continue
        if value is None:
            simctl("spawn", device, "launchctl", "unsetenv", key)
        else:
            simctl("spawn", device, "launchctl", "setenv", key, value)
    statefile.unlink()
    return dict(repaired=True, simulator=device)


def control(args, device, expected_session=None):
    if args.command_receipt and (args.command_receipt.exists() or args.command_receipt.is_symlink()):
        raise RuntimeError("Command receipt already exists; inspect before retrying.")
    container = target_container(args, device)
    root = container / "Documents/.callkit-simulator"
    session = json.loads((root / "session.json").read_text())
    if expected_session is not None and session != expected_session:
        raise RuntimeError("Runtime session changed; reconnect before sending controls.")
    if (session.get("schemaVersion") != 1 or session.get("bundleID") != args.bundle or
            not isinstance(session.get("pid"), int) or session["pid"] <= 0 or
            not re.fullmatch(r"[A-Za-z0-9_-]{1,64}", session.get("runID", ""))):
        raise RuntimeError("Invalid runtime session; launch the app with this runtime first.")
    identifier = str(uuid.uuid4()).upper()
    command = {key: session[key] for key in ("runID", "pid", "bundleID")}
    command.update(id=identifier, operation=args.operation)
    if getattr(args, "application", False):
        if args.operation not in ("hold", "merge", "unmerge"):
            raise RuntimeError("Application requests require hold, merge or unmerge.")
        command["applicationRequest"] = True
    for argument, field in (("call", "callUUID"), ("active_call", "activeCallUUID"),
                            ("held_call", "heldCallUUID"), ("group_with_call", "groupWithCallUUID")):
        if getattr(args, argument, None):
            command[field] = str(uuid.UUID(getattr(args, argument))).upper()
    if args.operation == "push":
        command.update(payload=json.loads(args.payload_file.read_text()), mustReport=args.must_report == "true")
    if args.operation == "hold":
        command["held"] = args.held == "true"
    if args.operation == "mute":
        command["muted"] = args.muted == "true"
    if args.operation == "tones":
        command["digits"] = args.digits
    if args.operation == "faults":
        command["faults"] = {field: value for argument, field in (("stale_audio", "staleAudio"),
            ("report_delay_ms", "reportCallbackDelayMS"), ("invalidate_during_handoff", "invalidateDuringHandoff"),
            ("incoming_error_code", "incomingErrorCode")) if (value := getattr(args, argument, None)) is not None}
        if not command["faults"]:
            command["faults"] = dict(staleAudio=False, reportCallbackDelayMS=0, invalidateDuringHandoff=False, incomingErrorCode=0)
    if args.operation == "incoming-filter":
        command["reason"] = args.reason
    mailbox = root / session["runID"]
    temporary = mailbox / f"requests/{identifier}.tmp"
    with temporary.open("x") as output:
        os.chmod(temporary, 0o600)
        json.dump(command, output)
    temporary.rename(temporary.with_suffix(".json"))
    if session.get("controlTransport") != "directory-watch-v1":
        notifier = args.runtime_dir.resolve() / "cksim-notify"
        simctl("spawn", device, notifier, session["notification"])
    response_path = mailbox / f"responses/{identifier}.json"
    deadline = time.monotonic() + args.timeout
    while time.monotonic() < deadline:
        if response_path.exists():
            response = json.loads(response_path.read_text())
            for field in ("id", "runID", "pid", "bundleID"):
                if response.get(field) != command[field]:
                    raise RuntimeError("Runtime response identity mismatch.")
            if args.command_receipt:
                with args.command_receipt.open("x") as output:
                    os.fchmod(output.fileno(), 0o600)
                    json.dump(dict(schemaVersion=1, session=session, request=command, response=response), output, indent=2)
                    output.write("\n")
            return response
        time.sleep(0.05)
    raise RuntimeError(f"Command {identifier} timed out; outcome is unknown. Query status/events before retrying.")


class RuntimeJournal:
    """Incremental reader of the runtime's versioned channel, shared by viewers."""
    def __init__(self, root, bundle):
        self.root = root
        self.session = json.loads((root / "session.json").read_text())
        s = self.session
        if (not isinstance(s, dict) or s.get("schemaVersion") != 1 or s.get("bundleID") != bundle or
                type(s.get("pid")) is not int or s["pid"] <= 0 or
                not isinstance(s.get("runID"), str) or not re.fullmatch(r"[A-Za-z0-9_-]{1,64}", s["runID"])):
            raise RuntimeError("Invalid runtime session; launch the app with this runtime first.")
        self.path = root / s["runID"] / "events.jsonl"
        self.offset = 0
        self.partial = b""
        self.sequence = 0

    def read_session_check(self):
        if json.loads((self.root / "session.json").read_text()) != self.session:
            raise RuntimeError("Runtime session changed; reconnect to the new run.")

    def read(self):
        self.read_session_check()
        if self.path.stat().st_size < self.offset:
            raise RuntimeError("Runtime journal was truncated; reconnect to the run.")
        with self.path.open("rb") as stream:
            stream.seek(self.offset)
            data = stream.read(1024 * 1024)
        self.offset += len(data)
        lines = (self.partial + data).split(b"\n")
        self.partial = lines.pop()
        if len(self.partial) > 1024 * 1024:
            raise RuntimeError("Runtime event exceeds 1 MiB.")
        rows = []
        for line in lines:
            row = json.loads(line)
            if (not isinstance(row, dict) or row.get("schemaVersion") != 1 or any(row.get(k) != self.session[k] for k in ("runID", "pid", "bundleID")) or
                    type(row.get("sequence")) is not int or row["sequence"] != self.sequence + 1 or
                    not isinstance(row.get("event"), str) or type(row.get("t_ms")) is not int or
                    type(row.get("wallTimeMS")) is not int):
                raise RuntimeError("Unsupported or inconsistent runtime event channel.")
            self.sequence = row["sequence"]
            rows.append(row)
        return rows


def timeline_line(row):
    detail = []
    for key in ("kind", "origin", "callerName", "callUUID", "uuid"):
        if row.get(key):
            detail.append("".join(c if c.isprintable() else "?" for c in str(row[key])))
    if "deadlineSeconds" in row:
        detail.append(f"budget {row['deadlineSeconds']:g}s ({row.get('apiKind', '')})")
    if row["event"] == "action.settled":
        detail.append(("fulfilled" if row["fulfilled"] else "failed") + f" in {row['latencyMS']:.1f}ms")
    if row["event"] == "call.changed":
        detail.append("ended" if row["ended"] else "held" if row["held"] else "connected" if row["connected"] else "ringing")
    return f"{row['sequence']:6} {row['t_ms'] / 1000:9.3f}s  {row['event']:<25} " + " · ".join(detail)


def watch(args, device):
    container = target_container(args, device)
    root = container / "Documents/.callkit-simulator"
    journal = RuntimeJournal(root, args.bundle)
    end = time.monotonic() + args.duration if args.duration else float("inf")
    after = args.after
    disconnected = False
    try:
        while True:
            try:
                rows = journal.read()
                disconnected = False
            except FileNotFoundError:
                if not disconnected:
                    print("Runtime disconnected; waiting for its next session.", file=sys.stderr)
                    disconnected = True
                if time.monotonic() >= end:
                    return
                time.sleep(0.1)
                continue
            except RuntimeError as error:
                if "session changed" not in str(error):
                    raise
                try:
                    journal = RuntimeJournal(root, args.bundle)
                except FileNotFoundError:
                    continue
                after = 0
                print("Runtime session changed; following " + journal.session["runID"], file=sys.stderr)
                continue
            for row in rows:
                if row["sequence"] > after:
                    print(json.dumps(row, separators=(",", ":")) if args.json else timeline_line(row), flush=True)
            if time.monotonic() >= end:
                return
            time.sleep(0.1)
    except KeyboardInterrupt:
        return


class InspectorBridge:
    """One inspector connection, pinned to the target's runtime session."""
    def __init__(self, args, device, root):
        import threading
        self.args, self.device = args, device
        self.journal = RuntimeJournal(root, args.bundle)
        self.lock = threading.Lock()
        self.previous_cursor = -1
        self.previous_batch = None

    def events(self, after):
        with self.lock:
            # A failed HTTP response may be retried without losing its batch.
            if after == self.previous_cursor:
                self.journal.read_session_check()
                return self.previous_batch
            if after != self.journal.sequence:
                raise RuntimeError("Timeline cursor changed; relaunch cksim inspect to reconnect.")
            rows = self.journal.read()
            batch = dict(session=self.journal.session, events=rows, cursor=self.journal.sequence)
            if rows:
                self.previous_cursor, self.previous_batch = after, batch
            return batch

    def command(self, value):
        from types import SimpleNamespace
        if isinstance(value, dict) and value.get("operation") == "faults":
            if set(value) != {"operation", "incomingErrorCode"} or value.get("incomingErrorCode") not in ("0", "4"):
                raise RuntimeError("Invalid incoming error fault.")
            arguments = dict(vars(self.args), operation="faults", incoming_error_code=int(value["incomingErrorCode"]),
                             stale_audio=None, report_delay_ms=None, invalidate_during_handoff=None, command_receipt=None)
            return control(SimpleNamespace(**arguments), self.device, expected_session=self.journal.session)
        if isinstance(value, dict) and value.get("operation") == "incoming-filter":
            if set(value) != {"operation", "reason"} or value.get("reason") not in INCOMING_FILTER_REASONS:
                raise RuntimeError("Invalid incoming filter control.")
            arguments = dict(vars(self.args), operation="incoming-filter", reason=value["reason"], command_receipt=None)
            return control(SimpleNamespace(**arguments), self.device, expected_session=self.journal.session)
        extra = {"hold": {"held"}, "merge": {"groupWithCallUUID"}, "unmerge": set(),
                 "end-held-and-accept": {"activeCallUUID", "heldCallUUID"}}
        legacy = ("answer", "decline", "end", "hold-and-accept", "end-and-accept")
        if not isinstance(value, dict) or value.get("operation") not in (*legacy, *extra):
            raise RuntimeError("Unsupported inspector control.")
        operation = value["operation"]
        required = {"operation", "callUUID"} | extra.get(operation, set())
        allowed = required if operation in extra else required | {"activeCallUUID"}
        if "applicationRequest" in value:
            if operation not in ("hold", "merge", "unmerge") or value["applicationRequest"] != "true":
                raise RuntimeError("Invalid application request control.")
            allowed |= {"applicationRequest"}
        if not required <= set(value) or set(value) - allowed:
            raise RuntimeError("Missing or unsupported inspector control parameters.")
        arguments = dict(vars(self.args), operation=operation, command_receipt=None,
                         application=value.get("applicationRequest") == "true")
        for field, argument in (("callUUID", "call"), ("activeCallUUID", "active_call"),
                                ("heldCallUUID", "held_call"), ("groupWithCallUUID", "group_with_call")):
            if field in value and not isinstance(value[field], str):
                raise RuntimeError("Inspector call identifiers must be UUID strings.")
            arguments[argument] = str(uuid.UUID(value[field])) if field in value else None
        if operation == "hold":
            if value["held"] not in ("true", "false"):
                raise RuntimeError("Inspector held must be true or false.")
            arguments["held"] = value["held"]
        if operation == "end-held-and-accept" and len({arguments[key] for key in ("call", "active_call", "held_call")}) != 3:
            raise RuntimeError("Waiting, active and held calls must be distinct.")
        return control(SimpleNamespace(**arguments), self.device, expected_session=self.journal.session)


def inspect_app(args, device):
    import http.server
    import secrets
    import threading
    import urllib.parse
    from types import SimpleNamespace
    if not args.app.is_dir() or args.app.suffix != ".app":
        raise RuntimeError("Build the simulator inspector first and pass inspect --app <CKSimInspector.app>.")
    print("Inspector: locating target runtime.", file=sys.stderr, flush=True)
    container = target_container(args, device).resolve()
    bridge_args = SimpleNamespace(**dict(vars(args), app_container=container))
    bridge = InspectorBridge(bridge_args, device, container / "Documents/.callkit-simulator")
    status = SimpleNamespace(**dict(vars(bridge_args), operation="status", command_receipt=None))
    print("Inspector: checking target runtime.", file=sys.stderr, flush=True)
    control(status, device, expected_session=bridge.journal.session)
    token = secrets.token_urlsafe(32)

    class Handler(http.server.BaseHTTPRequestHandler):
        def setup(self):
            super().setup()
            self.connection.settimeout(5)

        def log_message(self, *parts):
            pass

        def do_GET(self):
            self.respond(False)

        def do_POST(self):
            self.respond(True)

        def respond(self, command):
            if not secrets.compare_digest(self.headers.get("Authorization", "").encode(), ("Bearer " + token).encode()):
                self.send_error(401)
                return
            try:
                url = urllib.parse.urlsplit(self.path)
                if not command and url.path == "/events":
                    after = int(urllib.parse.parse_qs(url.query).get("after", ["0"])[0])
                    result = bridge.events(after)
                elif command and url.path == "/command":
                    size = int(self.headers.get("Content-Length", "0"))
                    if not 0 < size <= 4096:
                        raise RuntimeError("Invalid command size.")
                    result = bridge.command(json.loads(self.rfile.read(size)))
                else:
                    self.send_error(404)
                    return
                status = 200
            except (OSError, ValueError, TypeError, KeyError, RuntimeError) as error:
                result, status = dict(error=str(error)), 409
            data = json.dumps(result).encode()
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            try:
                self.wfile.write(data)
            except (BrokenPipeError, ConnectionResetError):
                pass

    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    server.daemon_threads = True
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    display = None
    owned_display = not args.inspector_simulator
    try:
        if args.inspector_simulator:
            display = simulator(args.inspector_simulator)
            if display == device and not getattr(args, "allow_shared_simulator", False):
                raise RuntimeError("Use a separate inspector simulator so the target app stays in the foreground.")
        else:
            devices = json.loads(simctl("list", "devices", "-j"))["devices"]
            runtime, target = next((runtime, d) for runtime, group in devices.items() for d in group if d["udid"] == device)
            display = simctl("create", "CKSim Inspector " + str(uuid.uuid4())[:8], target["deviceTypeIdentifier"], runtime)
            simctl("boot", display)
            simctl("bootstatus", display, "-b", timeout=300)
        print("Inspector: installing app on display simulator.", file=sys.stderr, flush=True)
        simctl("install", display, args.app.resolve())
        env = dict(os.environ, SIMCTL_CHILD_CKSIM_INSPECTOR_URL=f"http://127.0.0.1:{server.server_port}",
                   SIMCTL_CHILD_CKSIM_INSPECTOR_TOKEN=token)
        print("Inspector: launching app on display simulator.", file=sys.stderr, flush=True)
        launch_timeout = 20 if display == device else 180
        simctl("launch", "--terminate-running-process", display, "dev.callkitsim.inspector", env=env, timeout=launch_timeout)
        print(f"Inspector on {display}, connected to {args.bundle} ({bridge.journal.session['runID']}). Ctrl-C to disconnect.", flush=True)
        thread.join()
    except KeyboardInterrupt:
        pass
    finally:
        server.shutdown()
        server.server_close()
        if display and owned_display:
            try:
                simctl("shutdown", display)
            finally:
                simctl("delete", display)


def launch_push(args, device):
    """Stage a single simulator-only delivery, then become its real launcher.

    The SDK runtime consumes this envelope after installing its PushKit hooks.
    The app does not synthesize a push or report an incoming call on startup.
    """
    if args.launch_receipt.exists() or args.launch_receipt.is_symlink():
        raise RuntimeError("Launch receipt already exists; inspect before staging.")
    container = Path(simctl("get_app_container", device, args.bundle, "data"))
    try:
        query = subprocess.run(["xcrun", "simctl", "spawn", device, "launchctl", "list"], capture_output=True,
                               env={**os.environ, "SIMCTL_CHILD_DYLD_INSERT_LIBRARIES": ""}, timeout=SIMCTL_TIMEOUT)
    except subprocess.TimeoutExpired as error:
        raise RuntimeError("Stopped-app query timed out; inspect before staging.") from error
    if query.returncode or query.stderr:
        raise RuntimeError("Stopped-app query failed or returned diagnostics: " + query.stderr.decode(errors="replace"))
    services = query.stdout.decode()
    entries = [line.split() for line in services.splitlines() if line.split()]
    if (len(entries) < 2 or entries[0] != ["PID", "Status", "Label"] or
            any(len(row) != 3 or not re.fullmatch(r"-|[1-9][0-9]*", row[0]) or not re.fullmatch(r"-|-?[0-9]+", row[1]) for row in entries[1:])):
        raise RuntimeError("Invalid launchctl service table; cannot establish stopped app.")
    if any(row[0].isdigit() and int(row[0]) > 0 and row[-1].startswith("UIKitApplication:" + args.bundle + "[") for row in entries):
        raise RuntimeError("Push launch requires a stopped app; inspect/stop it before staging.")
    root = container / "Documents/.callkit-simulator"
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = root.lstat()
    if not stat.S_ISDIR(info.st_mode) or stat.S_IMODE(info.st_mode) != 0o700 or info.st_uid != os.getuid():
        raise RuntimeError("Unsafe push launch directory.")
    if (root / "push-launch.consuming").exists() or (root / "push-launch.consuming").is_symlink():
        raise RuntimeError("A push launch claim already exists; inspect before retrying.")
    payload = json.loads(args.payload_file.read_text())
    if not isinstance(payload, dict) or len(json.dumps(payload).encode()) > 5120:
        raise RuntimeError("Push payload must be an object of at most 5120 bytes.")
    nonce = str(uuid.uuid4()).upper()
    created = int(time.time() * 1000)
    value = dict(schemaVersion=1, id=nonce, runID=args.run_id, bundleID=args.bundle,
                 createdAtMS=created, expiresAtMS=created + 30000, mustReport=args.must_report == "true", payload=payload)
    data = (json.dumps(value, sort_keys=True) + "\n").encode()
    path = root / "push-launch.json"
    descriptor, temporary = tempfile.mkstemp(prefix=".push-launch-", dir=root)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            os.fchmod(stream.fileno(), 0o600)
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.link(temporary, path)  # exclusive atomic publication; never replace a pending push
    finally:
        os.unlink(temporary)
    receipt = dict(schemaVersion=1, simulatorID=device, bundleID=args.bundle, runID=args.run_id,
                   pushID=nonce, envelope=value, envelopeSHA256=hashlib.sha256(data).hexdigest(),
                   mode=stat.S_IMODE(path.stat().st_mode), appServiceAbsent=True,
                   serviceQuery=services, serviceQuerySHA256=hashlib.sha256(services.encode()).hexdigest(), runtimeInjectionRequested=False)
    with args.launch_receipt.open("x") as output:
        os.fchmod(output.fileno(), 0o600)
        json.dump(receipt, output, indent=2)
        output.write("\n")
    env = dict(os.environ, SIMCTL_CHILD_CKSIM_RUN_ID=args.run_id)
    # Preserve all inherited child overrides. No external runtime is injected.
    os.execvpe("xcrun", ["xcrun", "simctl", "launch", "--console", device, args.bundle], env)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--simulator", default="booted")
    parser.add_argument("--bundle")
    parser.add_argument("--runtime-dir", type=Path, default=Path(__file__).resolve().parent)
    parser.add_argument("--app-container", type=Path, help="Reuse a discovered target data container; simulator and session identity are checked")
    parser.add_argument("--timeout", type=float, default=15)
    parser.add_argument("--command-receipt", type=Path, help="Retain the exact request, response and session in a fresh file")
    commands = parser.add_subparsers(dest="operation", required=True)
    live = commands.add_parser("watch", help="Follow the shared runtime timeline (Ctrl-C to stop)")
    live.add_argument("--json", action="store_true", help="Emit the original versioned events as JSONL")
    live.add_argument("--after", type=int, default=0, help="Skip this run's events through this sequence")
    live.add_argument("--duration", type=float, help="Stop after this many seconds (for CI captures)")
    inspector = commands.add_parser("inspect", help="Launch the separate SwiftUI simulator inspector")
    inspector.add_argument("--app", type=Path, required=True, help="Built CKSimInspector.app")
    inspector.add_argument("--inspector-simulator", help="Reuse a separate booted simulator instead of creating a disposable display")
    inspector.add_argument("--allow-shared-simulator", action="store_true",
                           help="Allow a supplied shared display for a bounded, background-capable test fixture")
    for operation in ("status", "events", "inspect-adapter", "install", "uninstall", "repair", "launch", "reset"):
        commands.add_parser(operation)
    for operation in ("answer", "decline", "end", "unmerge"):
        cmd = commands.add_parser(operation)
        cmd.add_argument("call")
        if operation == "unmerge": cmd.add_argument("--application", action="store_true")
    merge = commands.add_parser("merge")
    merge.add_argument("call")
    merge.add_argument("--group-with-call", required=True)
    merge.add_argument("--application", action="store_true")
    hold = commands.add_parser("hold")
    hold.add_argument("call")
    hold.add_argument("--held", choices=("true", "false"), required=True)
    hold.add_argument("--application", action="store_true")
    mute = commands.add_parser("mute")
    mute.add_argument("call")
    mute.add_argument("--muted", choices=("true", "false"), required=True)
    tones = commands.add_parser("tones")
    tones.add_argument("call")
    tones.add_argument("--digits", required=True)
    for operation in ("hold-and-accept", "end-and-accept", "end-held-and-accept"):
        cmd = commands.add_parser(operation)
        cmd.add_argument("call")
        cmd.add_argument("--active-call", required=True)
        if operation == "end-held-and-accept":
            cmd.add_argument("--held-call", required=True)
    push = commands.add_parser("push")
    push.add_argument("--payload-file", type=Path, required=True)
    push.add_argument("--must-report", choices=("true", "false"), required=True)
    push.add_argument("--launch", action="store_true", help="Stage a push and launch a stopped SDK app (no DYLD injection)")
    push.add_argument("--run-id")
    push.add_argument("--launch-receipt", type=Path)
    faults = commands.add_parser("faults")
    faults.add_argument("--stale-audio", action="store_true", default=None)
    faults.add_argument("--report-delay-ms", type=int)
    faults.add_argument("--invalidate-during-handoff", action="store_true", default=None)
    faults.add_argument("--incoming-error-code", type=int, choices=(0, 4),
                        help="Inject code 4 (not produced by iOS 27.0 for LCK), or clear it with 0")
    incoming_filter = commands.add_parser("incoming-filter", help="Set the simulator's incoming-report filter")
    incoming_filter.add_argument("--reason", choices=INCOMING_FILTER_REASONS, required=True,
                                 help="Persistent filter for subsequent reports; codes 5–7 are unverified")
    args = parser.parse_args()
    if args.operation == "inspect" and args.allow_shared_simulator and not args.inspector_simulator:
        parser.error("--allow-shared-simulator requires an explicit --inspector-simulator")
    if args.app_container and (args.operation in ("install", "uninstall", "repair", "launch") or
                               args.operation == "push" and args.launch):
        parser.error("--app-container is only supported for running-app controls, watch and inspect")
    if args.operation == "tones" and not re.fullmatch(r"[0-9*#ABCDabcd]{1,64}", args.digits):
        parser.error("digits must contain 1-64 DTMF characters")
    if args.operation == "push" and args.launch and (not re.fullmatch(r"[A-Za-z0-9_-]{1,64}", args.run_id or "") or not args.launch_receipt):
        parser.error("push --launch requires --run-id and a fresh --launch-receipt")
    if (args.bundle is not None and not re.fullmatch(r"[A-Za-z0-9.-]+", args.bundle) or
            args.bundle is None and args.operation not in ("uninstall", "repair") or not 0 < args.timeout <= 120):
        parser.error("Require a bundle identifier and timeout in (0,120].")
    if args.operation == "watch" and (args.after < 0 or args.duration is not None and not 0 < args.duration <= 86400):
        parser.error("watch requires nonnegative --after and --duration in (0,86400].")
    if args.operation not in ("uninstall", "repair", "watch"):
        validate_package(args.runtime_dir.resolve())
    device = simulator(args.simulator)
    if args.operation == "watch":
        watch(args, device)
        return 0
    if args.operation == "inspect":
        inspect_app(args, device)
        return 0
    if args.operation == "install":
        result = install(args, device)
    elif args.operation == "uninstall":
        result = uninstall(device)
    elif args.operation == "repair":
        result = repair(device)
    elif args.operation == "launch":
        runtime = args.runtime_dir.resolve() / "CKSimRuntime.dylib"
        if not runtime.is_file():
            raise RuntimeError("Missing CKSimRuntime.dylib in --runtime-dir.")
        selected_runtime = launch_environment(device, "CKSIM_RUNTIME")
        if selected_runtime and Path(selected_runtime).resolve() != runtime.resolve():
            raise RuntimeError("Uninstall the other simulator runtime before launching this release.")
        inherited = os.environ.get("SIMCTL_CHILD_DYLD_INSERT_LIBRARIES", launch_environment(device, "DYLD_INSERT_LIBRARIES"))
        for library in (inherited or "").split(":"):
            if Path(library).name in ("CKSimRuntime.dylib", "CKSimLoader.dylib") and Path(library).resolve().parent != runtime.resolve().parent:
                raise RuntimeError("Another CallKit Simulator release is already injected; uninstall it first.")
        env = {**os.environ, "SIMCTL_CHILD_DYLD_INSERT_LIBRARIES": ":".join(filter(None, [inherited, str(runtime)])),
               "SIMCTL_CHILD_CKSIM_ENABLED": "1", "SIMCTL_CHILD_CKSIM_PROFILE": "ios-27.0"}
        result = dict(launch=simctl("launch", "--terminate-running-process", device, args.bundle, env=env))
    elif args.operation == "push" and args.launch:
        launch_push(args, device)
    else:
        result = control(args, device)
    print(json.dumps(result, indent=2))
    return 0 if result.get("success", True) else 1


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, KeyError, RuntimeError) as error:
        print(str(error), file=sys.stderr)
        raise SystemExit(1)
